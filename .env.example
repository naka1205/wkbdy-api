# Bind address. Keep the default loopback bind unless a reverse proxy fronts it.
HOST=127.0.0.1
PORT=7891
# Required. At least 8 characters; used for the admin login and re-encryption.
ADMIN_PASSWORD=change-this-admin-password
# Data directory holding wkbdy.db and encryption.key. Back up both together.
DATA_DIR=./data
STATIC_DIR=./static
LOG_LEVEL=info
# Initial client API keys, imported once at first startup. Manage later keys in the panel.
API_KEYS=
# Public base URL, used in API information and to choose secure session cookies.
PUBLIC_BASE_URL=http://localhost:7891
# WorkBuddy upstream. The gateway always streams upstream and rewrites the shape per client API.
WKB2API_UPSTREAM_URL=https://www.workbuddy.ai/v2/chat/completions
WKB2API_UPSTREAM_UA=WorkBuddy/2.137.1
# Product catalog source for /v1/models and reasoning/context capabilities. Left
# empty, the gateway derives it from the upstream host (`{upstream}/v3/config`).
WKB2API_CATALOG_URL=
# Optional local WorkBuddy credential file used by the panel account import.
WKB2API_CREDENTIALS_PATH=
# Temporary protocol recorder: set to a directory to append raw client and
# upstream traffic (bodies, headers, SSE frames) to dump-YYYY-MM-DD.jsonl.
# The file contains live credentials; delete it when the investigation ends.
# Set WKB2API_DUMP_REDACT=1 to store credentials as placeholders instead.
WKB2API_DUMP_DIR=
WKB2API_DUMP_REDACT=

# A random key is created in DATA_DIR/encryption.key by default.
# For managed secrets, provide a base64-encoded 32-byte key instead.
TOKEN_ENCRYPTION_KEY=
